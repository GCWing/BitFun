{
  "$description": "BitFun light semantic theme migrated from the built-in light Appearance.",
  "color": {
    "surface": {
      "canvas": { "$type": "color", "$value": "{ref.color.neutral.50}" },
      "panel": { "$type": "color", "$value": "{ref.color.neutral.0}" },
      "raised": { "$type": "color", "$value": "{ref.color.neutral.0}" },
      "scene": {
        "$description": "Primary content scene behind editors, terminals, and full-page work areas.",
        "$type": "color",
        "$value": "{ref.color.neutral.0}"
      },
      "workbench": {
        "$description": "Application workbench surrounding content scenes and panels.",
        "$type": "color",
        "$value": "{color.action.quiet.hover}"
      },
      "tertiary": {
        "$description": "Opaque low-emphasis container surface for persistent grouped content.",
        "$type": "color",
        "$value": "{ref.color.neutral.75}"
      },
      "chrome": {
        "$description": "Structural application chrome behind persistent navigation and window controls.",
        "$type": "color",
        "$value": "{ref.color.neutral.70}"
      },
      "subtle": {
        "$description": "Translucent local tint for transient feedback and small inset details; not a persistent container surface.",
        "$type": "color",
        "$value": "rgba(16, 26, 39, 0.03)"
      }
    },
    "overlay": {
      "scrim": {
        "$description": "Backdrop veil behind blocking modal surfaces.",
        "$type": "color",
        "$value": "rgba(16, 26, 39, 0.20)"
      }
    },
    "keyHint": {
      "background": { "$type": "color", "$value": "{color.action.neutral.surface}" }
    },
    "scrollbar": {
      "thumb": { "$type": "color", "$value": "{color.action.neutral.surfaceHover}" },
      "thumbHover": { "$type": "color", "$value": "{color.action.neutral.surfacePressed}" }
    },
    "content": {
      "primary": { "$type": "color", "$value": "{ref.color.neutral.900}" },
      "secondary": { "$type": "color", "$value": "{ref.color.neutral.750}" },
      "muted": { "$type": "color", "$value": "{ref.color.neutral.650}" },
      "disabled": { "$type": "color", "$value": "{ref.color.neutral.450}" },
      "inverse": { "$type": "color", "$value": "{ref.color.neutral.0}" },
      "onDark": {
        "$description": "Content that must remain legible on a known dark or image-backed surface.",
        "$type": "color",
        "$value": "{ref.color.neutral.0}"
      },
      "onLight": {
        "$description": "Content that must remain legible on a known light surface.",
        "$type": "color",
        "$value": "{ref.color.neutral.1000}"
      }
    },
    "accent": {
      "default": { "$type": "color", "$value": "{ref.color.cyan.500}" },
      "hover": { "$type": "color", "$value": "{ref.color.cyan.500}" },
      "disabled": { "$type": "color", "$value": "rgba(5, 156, 176, 0.30)" },
      "surfaceSubtle": { "$type": "color", "$value": "color-mix(in srgb, {color.accent.default} 5%, transparent)" },
      "surface": { "$type": "color", "$value": "color-mix(in srgb, {color.accent.default} 9%, transparent)" },
      "surfaceStrong": { "$type": "color", "$value": "color-mix(in srgb, {color.accent.default} 15%, transparent)" },
      "borderSubtle": { "$type": "color", "$value": "color-mix(in srgb, {color.accent.default} 25%, transparent)" },
      "border": { "$type": "color", "$value": "color-mix(in srgb, {color.accent.default} 40%, transparent)" },
      "secondary": {
        "$description": "Secondary product emphasis for paired accents and identity gradients.",
        "$type": "color",
        "$value": "{ref.color.purple.600}"
      },
      "secondaryHover": { "$type": "color", "$value": "{ref.color.purple.700}" },
      "secondarySurface": { "$type": "color", "$value": "color-mix(in srgb, {color.accent.secondary} 9%, transparent)" },
      "secondarySurfaceStrong": { "$type": "color", "$value": "color-mix(in srgb, {color.accent.secondary} 15%, transparent)" },
      "secondaryBorder": { "$type": "color", "$value": "color-mix(in srgb, {color.accent.secondary} 25%, transparent)" }
    },
    "identity": {
      "assistant": {
        "$description": "Named assistant identity used where it must remain distinct from the primary and secondary product accents.",
        "content": { "$type": "color", "$value": "{ref.color.pink.600}" },
        "contentHover": { "$type": "color", "$value": "{ref.color.pink.700}" },
        "surfaceSubtle": { "$type": "color", "$value": "color-mix(in srgb, {color.identity.assistant.content} 5%, transparent)" },
        "surface": { "$type": "color", "$value": "color-mix(in srgb, {color.identity.assistant.content} 9%, transparent)" },
        "border": { "$type": "color", "$value": "color-mix(in srgb, {color.identity.assistant.content} 15%, transparent)" }
      },
      "globalSearch": {
        "$description": "Stable wayfinding identities for the six primary Global Search actions; these colors do not imply status.",
        "newSession": { "$type": "color", "$value": "{ref.color.red.650}" },
        "openBrowser": { "$type": "color", "$value": "{ref.color.amber.550}" },
        "openTerminal": { "$type": "color", "$value": "{color.action.neutral.content}" },
        "openProject": { "$type": "color", "$value": "{ref.color.cyan.500}" },
        "newProject": { "$type": "color", "$value": "{ref.color.blue.575}" },
        "openFiles": { "$type": "color", "$value": "{ref.color.purple.450}" }
      },
      "harness": {
        "$description": "Stable identities for the four selectable Agent Harness profiles.",
        "minimal": { "$type": "color", "$value": "{ref.color.purple.550}" },
        "standard": { "$type": "color", "$value": "{ref.color.green.550}" },
        "ultimate": { "$type": "color", "$value": "{ref.color.amber.550}" },
        "creative": { "$type": "color", "$value": "{ref.color.blue.550}" }
      }
    },
    "link": {
      "default": { "$type": "color", "$value": "{ref.color.blue.600}" },
      "hover": { "$type": "color", "$value": "{ref.color.blue.700}" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "rgba(16, 26, 39, 0.08)" },
      "default": { "$type": "color", "$value": "rgba(16, 26, 39, 0.15)" },
      "strong": { "$type": "color", "$value": "rgba(16, 26, 39, 0.34)" }
    },
    "action": {
      "neutral": {
        "border": { "$type": "color", "$value": "rgba(0, 0, 0, 0.05)" },
        "content": { "$type": "color", "$value": "rgba(0, 0, 0, 0.80)" },
        "contentDisabled": { "$type": "color", "$value": "rgba(0, 0, 0, 0.30)" },
        "fillBorder": { "$type": "color", "$value": "{color.action.neutral.surface}" },
        "surface": { "$type": "color", "$value": "rgba(0, 0, 0, 0.05)" },
        "surfaceHover": { "$type": "color", "$value": "rgba(0, 0, 0, 0.08)" },
        "surfacePressed": { "$type": "color", "$value": "rgba(0, 0, 0, 0.10)" }
      },
      "primary": {
        "background": { "$type": "color", "$value": "{ref.color.navy.950}" },
        "hover": { "$type": "color", "$value": "{ref.color.neutral.900}" },
        "pressed": { "$type": "color", "$value": "{ref.color.neutral.1000}" },
        "content": { "$type": "color", "$value": "{ref.color.neutral.0}" }
      },
      "secondary": {
        "background": { "$type": "color", "$value": "{ref.color.neutral.100}" },
        "hover": { "$type": "color", "$value": "rgba(16, 26, 39, 0.09)" },
        "pressed": { "$type": "color", "$value": "rgba(16, 26, 39, 0.13)" },
        "content": { "$type": "color", "$value": "{ref.color.neutral.900}" }
      },
      "quiet": {
        "hover": { "$type": "color", "$value": "{ref.color.neutral.100}" },
        "pressed": { "$type": "color", "$value": "rgba(16, 26, 39, 0.09)" },
        "content": { "$type": "color", "$value": "{ref.color.neutral.750}" }
      }
    },
    "selection": {
      "surface": {
        "$description": "Persistent neutral selection fill, distinct from transient pressed feedback.",
        "$type": "color",
        "$value": "{color.action.neutral.surfaceHover}"
      }
    },
    "field": {
      "background": { "$type": "color", "$value": "{ref.color.neutral.0}" },
      "backgroundHover": { "$type": "color", "$value": "{color.field.background}" },
      "border": { "$type": "color", "$value": "rgba(16, 26, 39, 0.15)" },
      "borderHover": { "$type": "color", "$value": "rgba(16, 26, 39, 0.24)" },
      "borderFocus": { "$type": "color", "$value": "{ref.color.navy.950}" }
    },
    "control": {
      "switch": {
        "track": { "$type": "color", "$value": "{ref.color.neutral.250}" },
        "trackChecked": { "$type": "color", "$value": "{ref.color.green.500}" },
        "thumb": { "$type": "color", "$value": "{ref.color.neutral.0}" }
      }
    },
    "focus": {
      "ring": { "$type": "color", "$value": "{ref.color.neutral.650}" }
    },
    "status": {
      "info": {
        "content": { "$type": "color", "$value": "{ref.color.neutral.750}" },
        "surface": { "$type": "color", "$value": "{ref.color.neutral.100}" },
        "border": { "$type": "color", "$value": "rgba(16, 26, 39, 0.15)" }
      },
      "success": {
        "content": { "$type": "color", "$value": "{ref.color.green.700}" },
        "surface": { "$type": "color", "$value": "{ref.color.green.100}" },
        "border": { "$type": "color", "$value": "{ref.color.green.700}" }
      },
      "warning": {
        "content": { "$type": "color", "$value": "{ref.color.amber.800}" },
        "surface": { "$type": "color", "$value": "rgba(154, 101, 31, 0.08)" },
        "border": { "$type": "color", "$value": "rgba(154, 101, 31, 0.25)" }
      },
      "danger": {
        "content": { "$type": "color", "$value": "{ref.color.red.700}" },
        "surface": { "$type": "color", "$value": "rgba(167, 67, 82, 0.12)" },
        "border": { "$type": "color", "$value": "rgba(167, 67, 82, 0.36)" }
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "xs": { "$value": "0 1px 2px rgba(16, 26, 39, 0.04)" },
    "sm": { "$value": "0 2px 4px rgba(16, 26, 39, 0.055)" },
    "base": { "$value": "0 4px 8px rgba(16, 26, 39, 0.07)" },
    "lg": { "$value": "0 8px 16px rgba(16, 26, 39, 0.09)" },
    "xl": { "$value": "0 12px 24px rgba(16, 26, 39, 0.11)" },
    "raised": { "$value": "{shadow.sm}" },
    "composer": { "$value": "0 2px 6px rgba(0, 0, 0, 0.08)" },
    "menu": { "$value": "0 4px 10px rgba(0, 0, 0, 0.12)" },
    "overlay": { "$value": "0 4px 20px rgba(0, 0, 0, 0.12)" },
    "accentGlow": {
      "$description": "Layered emphasis glow derived from the active accent.",
      "$value": "0 12px 32px color-mix(in srgb, {color.accent.hover} 25%, transparent), 0 6px 16px color-mix(in srgb, {color.accent.default} 18%, transparent), 0 3px 8px rgba(0, 0, 0, 0.12)"
    },
    "innerHighlight": { "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.08)" },
    "innerHighlightHover": { "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.24)" }
  },
  "effect": {
    "blur": {
      "subtle": { "$type": "filter", "$value": "blur(4px) saturate(1.02)" },
      "base": { "$type": "filter", "$value": "blur(8px) saturate(1.05)" },
      "medium": { "$type": "filter", "$value": "blur(12px) saturate(1.2)" }
    }
  },
  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.55 },
    "hover": { "$value": 0.75 },
    "focus": { "$value": 0.9 },
    "muted": { "$value": "{opacity.hover}" }
  }
}
