{
  "$description": "Theme-independent system scales.",
  "space": {
    "$type": "dimension",
    "0": { "$value": "0px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "component": {
      "inline": { "$value": "12px" },
      "block": { "$value": "8px" }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": "'Noto Sans SC', -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Segoe UI', 'Microsoft YaHei UI', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif"
      },
      "control": {
        "$type": "fontFamily",
        "$value": "'SF Pro Text', -apple-system, BlinkMacSystemFont, 'Noto Sans SC', 'PingFang SC', 'Hiragino Sans GB', 'Segoe UI', 'Microsoft YaHei UI', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "'JetBrains Mono', 'FiraCode', ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Monaco, 'Cascadia Mono', 'Cascadia Code', Consolas, 'Liberation Mono', 'Courier New', monospace"
      }
    },
    "size": {
      "$type": "dimension",
      "micro": { "$value": "10px" },
      "xs": { "$value": "12px" },
      "sm": { "$value": "13px" },
      "base": { "$value": "14px" },
      "lg": { "$value": "15px" },
      "xl": { "$value": "16px" },
      "2xl": { "$value": "18px" },
      "3xl": { "$value": "22px" },
      "4xl": { "$value": "26px" },
      "caption": { "$value": "{font.size.xs}" },
      "small": { "$value": "{font.size.sm}" },
      "body": { "$value": "{font.size.base}" },
      "label": { "$value": "{font.size.base}" },
      "title": { "$value": "{font.size.2xl}" },
      "display": { "$value": "{font.size.4xl}" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": "{font.weight.semibold}" }
    }
  },
  "lineHeight": {
    "$type": "number",
    "tight": { "$value": 1.2 },
    "base": { "$value": 1.5 },
    "body": { "$value": "{lineHeight.base}" },
    "relaxed": { "$value": 1.6 }
  },
  "control": {
    "height": {
      "$type": "dimension",
      "sm": { "$value": "32px" },
      "md": { "$value": "40px" },
      "lg": { "$value": "48px" }
    },
    "hitTarget": {
      "$type": "dimension",
      "$value": "40px"
    },
    "switch": {
      "$type": "dimension",
      "trackWidth": { "$value": "28px" },
      "trackHeight": { "$value": "16px" },
      "thumbSize": { "$value": "12px" },
      "thumbInset": { "$value": "2px" },
      "thumbTravel": { "$value": "12px" },
      "thumbTravelReverse": { "$value": "-12px" }
    },
    "tabGroup": {
      "$type": "dimension",
      "gap": { "$value": "{space.2}" },
      "itemGap": { "$value": "6px" },
      "itemHeight": { "$value": "{control.height.md}" },
      "itemIconSize": { "$value": "16px" },
      "itemPaddingInline": { "$value": "{space.4}" },
      "itemActionSize": { "$value": "{space.5}" },
      "itemActionInset": { "$value": "{space.2}" },
      "itemRadius": { "$value": "{radius.pill}" }
    },
    "composer": {
      "$type": "dimension",
      "minBlockSize": { "$value": "120px" },
      "contextOffset": { "$value": "32px" },
      "contextPaddingBlock": { "$value": "6px" },
      "contextPaddingInline": { "$value": "{space.2}" },
      "contextGap": { "$value": "{space.2}" },
      "surfacePadding": { "$value": "{space.2}" },
      "surfaceGap": { "$value": "{space.3}" },
      "surfaceRadius": { "$value": "{radius.xl}" },
      "editorPadding": { "$value": "{space.1}" },
      "toolbarGap": { "$value": "{space.2}" },
      "dividerBlockSize": { "$value": "16px" }
    },
    "activityItem": {
      "$type": "dimension",
      "inlineGap": { "$value": "{space.1}" },
      "inlineIconSize": { "$value": "12px" },
      "inlineFontSize": { "$value": "11px" },
      "inlineLineHeight": { "$value": "17px" },
      "surfaceHeight": { "$value": "30px" },
      "surfaceGap": { "$value": "{space.2}" },
      "surfacePaddingBlock": { "$value": "{space.1}" },
      "surfacePaddingInlineStart": { "$value": "{space.2}" },
      "surfacePaddingInlineEnd": { "$value": "3px" },
      "surfaceRadius": { "$value": "{radius.base}" },
      "surfaceIconSize": { "$value": "14px" },
      "contentGap": { "$value": "{space.1}" },
      "dividerBlockSize": { "$value": "16px" }
    },
    "changeCount": {
      "$type": "dimension",
      "gap": { "$value": "{space.1}" },
      "paddingBlock": { "$value": "2px" },
      "paddingInline": { "$value": "{space.1}" },
      "radius": { "$value": "{radius.xs}" },
      "fontSize": { "$value": "11px" }
    },
    "iconButton": {
      "$type": "dimension",
      "xsSize": { "$value": "22px" },
      "xsIconSize": { "$value": "14px" }
    },
    "button": {
      "$type": "dimension",
      "xsHeight": { "$value": "24px" },
      "xsPaddingInline": { "$value": "6px" },
      "xsLeadingIconSize": { "$value": "12px" },
      "xsTrailingIconSize": { "$value": "10px" },
      "xsFontSize": { "$value": "11px" }
    }
  },
  "layout": {
    "$type": "dimension",
    "card": {
      "paddingSm": { "$value": "{space.3}" },
      "paddingMd": { "$value": "{space.5}" },
      "gapSm": { "$value": "{space.2}" },
      "gapMd": { "$value": "{space.3}" },
      "gapLg": { "$value": "30px" },
      "radiusSm": { "$value": "{radius.base}" },
      "radiusMd": { "$value": "{radius.lg}" },
      "radiusLg": { "$value": "28px" },
      "headerGap": { "$value": "{space.2}" },
      "titleDescriptionGap": { "$value": "{space.1}" },
      "footerGap": { "$value": "{space.2}" },
      "mediaMinBlockSize": { "$value": "120px" }
    },
    "toolbar": {
      "smHeight": { "$value": "33px" },
      "mdHeight": { "$value": "45px" },
      "contentGap": { "$value": "40px" },
      "smPaddingBlock": { "$value": "{space.1}" },
      "smPaddingInline": { "$value": "{space.2}" },
      "mdPaddingBlockStart": { "$value": "{space.2}" },
      "mdPaddingBlockEnd": { "$value": "6px" },
      "mdPaddingInlineStart": { "$value": "{space.2}" },
      "mdPaddingInlineEnd": { "$value": "11px" },
      "groupGapSm": { "$value": "{space.1}" },
      "groupGapMd": { "$value": "{space.2}" },
