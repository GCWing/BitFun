    "navigationPanel": {
      "inlineSize": { "$value": "216px" },
      "surfacePadding": { "$value": "{space.2}" },
      "contentGap": { "$value": "{space.4}" },
      "sectionGap": { "$value": "{space.1}" },
      "headingHeight": { "$value": "22px" },
      "headingPaddingInline": { "$value": "{space.2}" },
      "headingGap": { "$value": "{space.5}" },
      "headingFontSize": { "$value": "11px" },
      "headingActionSize": { "$value": "22px" },
      "itemHeight": { "$value": "30px" },
      "itemPaddingInline": { "$value": "{space.2}" },
      "itemGap": { "$value": "{space.2}" },
      "itemRadius": { "$value": "{radius.base}" },
      "itemIconSize": { "$value": "14px" },
      "scrollbarGap": { "$value": "2px" },
      "footerHeight": { "$value": "40px" },
      "footerPadding": { "$value": "{space.2}" }
    },
    "splitView": {
      "contentPanelRadius": {
        "$description": "Corner radius for the content panel where it meets a companion navigation panel.",
        "$value": "{radius.3xl}"
      }
    }
  },
  "scrollbar": {
    "$type": "dimension",
    "width": {
      "$description": "Reference thickness for compact application scrollbars.",
      "$value": "6px"
    },
    "radius": {
      "$description": "Corner radius for the scrollbar thumb.",
      "$value": "{radius.pill}"
    }
  },
  "overlay": {
    "menu": {
      "$type": "dimension",
      "inlineSize": { "$value": "220px" },
      "maxBlockSize": { "$value": "480px" },
      "surfacePadding": { "$value": "{space.2}" },
      "surfaceRadius": { "$value": "{radius.xl}" },
      "sectionGap": { "$value": "{space.2}" },
      "headingHeight": { "$value": "24px" },
      "headingPaddingInline": { "$value": "{space.2}" },
      "headingGap": { "$value": "{space.5}" },
      "headingFontSize": { "$value": "11px" },
      "headingActionSize": { "$value": "22px" },
      "itemHeight": { "$value": "30px" },
      "itemPaddingInline": { "$value": "{space.2}" },
      "itemGap": { "$value": "{space.2}" },
      "itemRadius": { "$value": "{radius.base}" },
      "itemIconSize": { "$value": "14px" },
      "scrollbarGap": { "$value": "2px" }
    },
    "modal": {
      "$type": "dimension",
      "viewportGutter": {
        "$description": "Minimum viewport inset reserved around a centered modal.",
        "$value": "24px"
      },
      "edgeGutter": {
        "$description": "Inset shared by modal header chrome and the close action.",
        "$value": "8px"
      },
      "backdropBlur": {
        "$description": "Background blur applied by the reference modal scrim.",
        "$type": "filter",
        "$value": "blur(40px)"
      },
      "surfaceRadius": {
        "$description": "Reference corner radius for the modal surface.",
        "$value": "28px"
      },
      "headerGap": {
        "$value": "{space.5}"
      },
      "headerPaddingBlockStart": {
        "$value": "{space.6}"
      },
      "headerPaddingBlockEnd": {
        "$value": "{space.5}"
      },
      "headerPaddingInline": {
        "$value": "{space.6}"
      },
      "titleFontSize": {
        "$value": "24px"
      },
      "titleFontWeight": {
        "$type": "fontWeight",
        "$value": 700
      },
      "scrollbarWidth": {
        "$value": "{scrollbar.width}"
      },
      "contentPaddingSm": { "$value": "{space.3}" },
      "contentPaddingMd": { "$value": "{space.4}" },
      "contentPaddingLg": { "$value": "{space.6}" },
      "contentPaddingXl": { "$value": "{space.8}" },
      "descriptionGap": { "$value": "{space.2}" },
      "headerActionsGap": { "$value": "{space.2}" },
      "footerGap": { "$value": "{space.2}" },
      "footerPaddingBlockStart": { "$value": "{space.2}" },
      "footerPaddingBlockEnd": { "$value": "{space.5}" },
      "footerPaddingInline": { "$value": "{space.6}" },
      "footerHeight": {
        "$description": "Total visual height of the floating modal action bar.",
        "$value": "68px"
      },
      "footerFadeExtent": {
        "$description": "Distance the frosted footer treatment extends upward over scrolling content.",
        "$value": "{space.6}"
      },
      "footerContentInset": {
        "$description": "Trailing scroll space that keeps content reachable beneath the floating modal action bar.",
        "$value": "104px"
      },
      "footerBlur": {
        "$description": "Backdrop blur applied to content passing beneath the floating modal action bar.",
        "$type": "filter",
        "$value": "blur(20px)"
      },
      "footerActionMinWidth": { "$value": "100px" },
      "maxInlineSizeSmall": { "$value": "420px" },
      "maxInlineSizeMedium": { "$value": "560px" },
      "maxInlineSizeLarge": { "$value": "600px" },
      "maxInlineSizeXlarge": { "$value": "720px" },
      "maxInlineSizeXxlarge": { "$value": "960px" },
      "maxInlineSizeWide": { "$value": "1200px" }
    }
  },
  "radius": {
    "$type": "dimension",
    "xs": { "$value": "4px" },
    "sm": { "$value": "6px" },
    "base": { "$value": "8px" },
    "md": { "$value": "{radius.base}" },
    "lg": { "$value": "12px" },
    "xl": { "$value": "16px" },
    "2xl": { "$value": "20px" },
    "3xl": { "$value": "24px" },
    "4xl": { "$value": "32px" },
    "pill": { "$value": "9999px" }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "default": { "$value": "1px" },
      "strong": { "$value": "2px" }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "80ms" },
      "fast": { "$value": "140ms" },
      "base": { "$value": "220ms" },
      "normal": { "$value": "{motion.duration.base}" },
      "slow": { "$value": "420ms" },
      "lazy": { "$value": "1s" },
      "loop": { "$value": "720ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": "cubic-bezier(0.23, 1, 0.32, 1)" },
      "decelerate": { "$value": "{motion.easing.standard}" },
      "smooth": { "$value": "cubic-bezier(0.77, 0, 0.175, 1)" },
      "accelerate": { "$value": "cubic-bezier(0.4, 0, 1, 1)" },
      "enter": { "$value": "{motion.easing.standard}" },
      "exit": { "$value": "cubic-bezier(0.3, 0, 1, 1)" }
    }
  },
  "focus": {
    "width": { "$type": "dimension", "$value": "2px" },
    "offset": { "$type": "dimension", "$value": "2px" }
  },
  "layer": {
    "$type": "number",
    "base": { "$value": 0 },
    "decoration": { "$value": 1 },
    "content": { "$value": 2 },
    "sticky": { "$value": 15 },
    "floating": { "$value": 50 },
    "dropdown": { "$value": 60 },
    "overlay": { "$value": 100 },
    "modal": { "$value": 200 },
    "modalActive": { "$value": 250 },
    "fullscreen": { "$value": 280 },
    "overlayHost": { "$value": 300 },
    "tooltip": { "$value": 350 },
    "popover": { "$value": 360 },
    "toast": { "$value": 400 },
    "notification": { "$value": 400 },
    "contextMenu": { "$value": 500 }
  }
}
