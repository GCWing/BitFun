{
  "name": "@openbitfun/design-tokens",
  "version": "0.1.0",
  "description": "Framework-neutral design token contract and system scales for OpenBitFun UI packages",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./typography-runtime": {
      "types": "./dist/typography-runtime.d.ts",
      "import": "./dist/typography-runtime.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@openbitfun/token-engine": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
