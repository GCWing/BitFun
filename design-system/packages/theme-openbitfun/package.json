{
  "name": "@openbitfun/theme-openbitfun",
  "version": "0.1.0",
  "description": "Replaceable OpenBitFun light, dark, and high-contrast theme package",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./authoring": {
      "types": "./dist/authoring.d.ts",
      "import": "./dist/authoring.js"
    },
    "./default.css": "./dist/default.css",
    "./reference-colors.json": "./dist/reference-colors.json",
    "./themes.css": "./dist/themes.css",
    "./theme-data.json": "./dist/theme-data.json",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@openbitfun/design-tokens": "workspace:^"
  },
  "devDependencies": {
    "@openbitfun/token-engine": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
