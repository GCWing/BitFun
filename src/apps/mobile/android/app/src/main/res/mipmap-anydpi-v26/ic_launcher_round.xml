<?xml version="1.0" encoding="utf-8"?>
<!--
  `android:roundIcon`, which launchers on round-icon devices ask for by name.
  An adaptive icon is already mask-agnostic, so this is the same three layers as
  `ic_launcher.xml` rather than a second, pre-rounded drawing.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
