<?xml version="1.0" encoding="utf-8"?>
<!--
    HarmonyOS `sys.symbol.wrench_and_screwdriver`, redrawn.

    Two tools crossed, which is the whole point of the glyph and the reason
    Material's `Build` — a single spanner — is not a substitute: this row is
    "local custom", the one model this phone defines itself, and the source
    marks it with the toolkit rather than with one tool.

    Down-right is the adjustable wrench: a shaft with an open C jaw at each end,
    each jaw a 270-degree arc whose gap faces out along the shaft. Up-right is
    the screwdriver: a fat capsule handle at the bottom left, a thin shank, and a
    blunt tip that is wider than the shank and narrower than the handle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Wrench: shaft, then the two jaws. -->
    <path
        android:pathData="M8.1,8.1 L15.9,15.9"
        android:strokeWidth="1.7"
        android:strokeColor="#000000"
        android:strokeLineCap="round" />
    <path
        android:pathData="M6.3,3.9 A2.4,2.4 0 1 1 3.9,6.3"
        android:strokeWidth="1.7"
        android:strokeColor="#000000"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M17.7,20.1 A2.4,2.4 0 1 1 20.1,17.7"
        android:strokeWidth="1.7"
        android:strokeColor="#000000"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <!-- Screwdriver: handle, shank, tip. -->
    <path
        android:pathData="M4.5,19.5 L7.4,16.6"
        android:strokeWidth="4.2"
        android:strokeColor="#000000"
        android:strokeLineCap="round" />
    <path
        android:pathData="M8.9,15.1 L14.6,9.4"
        android:strokeWidth="1.7"
        android:strokeColor="#000000"
        android:strokeLineCap="round" />
    <path
        android:pathData="M15.4,8.6 L18.6,5.4"
        android:strokeWidth="2.6"
        android:strokeColor="#000000"
        android:strokeLineCap="round" />
</vector>
