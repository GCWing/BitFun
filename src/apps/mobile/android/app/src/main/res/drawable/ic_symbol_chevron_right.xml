<!--
    HarmonyOS `sys.symbol.chevron_right`, redrawn — the mirror of
    `ic_symbol_chevron_left`, drawn separately rather than auto-mirrored because
    these two never swap: the back chevron flips with the layout direction and
    this disclosure one does too, but they point opposite ways in either.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:autoMirrored="true">
    <path
        android:pathData="M9.4,5.4 L15.9,12 L9.4,18.6"
        android:strokeWidth="1.9"
        android:strokeColor="#000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
