<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher mark, as every device we ship to draws it: `minSdk` is 26, so
  this file — not the legacy bitmap beside it — is what a home screen shows.

  The layers keep the field and mark separate so the launcher's own mask can
  crop the black application icon to whatever shape the device uses. The
  foreground is the white OpenBitFun mark on transparency, sized to the safe
  area inside the 108dp adaptive-icon canvas.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- Themed icons (Android 13+) get a tint; the mark's alpha preserves its
         negative-space geometry when the launcher applies that tint. -->
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
